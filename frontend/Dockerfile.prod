FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
# registry.npmjs.org с части VPS недоступен — тогда npmmirror / Tencent.
RUN npm ci \
    || (rm -rf node_modules && npm ci --registry=https://registry.npmmirror.com) \
    || (rm -rf node_modules && npm ci --registry=https://mirrors.cloud.tencent.com/npm/)

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
